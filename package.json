{
  "name": "lilabs-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "license": "GPL-3.0",
  "homepage": "https://lilabs.aliahad.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/LiLabsAI/LiLabs.git"
  },
  "description": "LI Labs — Independent Software & AI Research Initiative founded by Ali Ahad",
  "scripts": {
    "dev": "vite",
    "dev:worker": "pnpm exec cf dev",
    "build": "vite build && node scripts/build-cf.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit",
    "lint": "biome lint src scripts tests cloudflare.config.ts vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test",
    "deploy": "pnpm run build && pnpm exec cf deploy --prebuilt --mode production"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.179.1",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@cloudflare/build-output-utils": "^0.8.0",
    "@cloudflare/config": "^0.18.0",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.5.1",
    "cf": "^0.15.0",
    "esbuild": "^0.28.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
